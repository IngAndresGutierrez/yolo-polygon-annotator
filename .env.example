# Copy to .env to override defaults (all values are optional).

# Host ports (always bound to 127.0.0.1 only)
FRONTEND_PORT=5173
API_PORT=8000

# Container user id/group id. On Linux set these to `id -u` / `id -g` so the
# bind-mounted ./workspace stays writable by both you and the container.
APP_UID=1000
APP_GID=1000

# Backend limits
MAX_UPLOAD_MB=25            # per image file
MAX_XML_KB=1024             # per PASCAL VOC file
MAX_FILES_PER_REQUEST=200
MAX_IMAGE_PIXELS=60000000   # decompression-bomb guard

# Geometry: minimum polygon area in px² (frontend reads this from /api/health)
MIN_POLYGON_AREA=16

# Max dHash bit difference to warn about near-duplicate images
NEAR_DUPLICATE_THRESHOLD=4

# Allowed browser origins when calling the API directly (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
